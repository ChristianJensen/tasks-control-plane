{
  "openapi": "3.0.3",
  "info": {
    "title": "Tasks API",
    "version": "0.7.0",
    "description": "Shared contract between api and frontend repos"
  },
  "paths": {
    "/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "List all tasks",
        "description": "Returns all tasks, optionally filtered by status. Use comma-separated values to filter by multiple statuses.",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Comma-separated list of statuses to filter by (e.g. todo,in-progress)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Field to sort by. Defaults to createdAt. Status sort uses workflow order: todo=0, in-progress=1, done=2.",
            "schema": {
              "type": "string",
              "enum": [
                "createdAt",
                "title",
                "status"
              ],
              "default": "createdAt"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Sort direction. Defaults to desc. Tiebreaker for equal values is createdAt desc.",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid status filter value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createTask",
        "summary": "Create a new task",
        "description": "Creates a task. Status defaults to 'todo' if not provided.",
        "tags": [
          "tasks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "status": {
                    "$ref": "#/components/schemas/TaskStatus"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/batch-delete": {
      "post": {
        "operationId": "batchDeleteTasks",
        "summary": "Delete multiple tasks",
        "description": "Permanently deletes multiple tasks and all their associated comments and status history entries (cascade). Handles partial success: valid tasks are deleted even if some IDs are not found. Returns 200 for all valid requests, including when all IDs are not found.",
        "tags": [
          "tasks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 1,
                    "maxItems": 50,
                    "description": "Array of task IDs to delete. Duplicates are deduplicated."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch delete processed. Check deleted and notFound arrays for details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchDeleteResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body (empty array, exceeds 50 IDs, or malformed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/batch-update-category": {
      "post": {
        "operationId": "batchUpdateCategory",
        "summary": "Bulk assign category to multiple tasks",
        "description": "Updates the category for multiple tasks in one request. Handles partial success: valid tasks are updated even if some IDs are not found. Returns 200 for all valid requests, including when all IDs are not found. Requires X-User-Id header.",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/XUserId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids",
                  "category"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 1,
                    "maxItems": 50,
                    "description": "Array of task IDs to update. Duplicates are deduplicated."
                  },
                  "category": {
                    "oneOf": [
                      { "$ref": "#/components/schemas/TaskCategory" },
                      { "type": "null" }
                    ],
                    "description": "Category to assign. Null clears the category."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch update processed. Check updated and notFound arrays for details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchUpdateCategoryResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body (empty array, exceeds 50 IDs, invalid category, missing X-User-Id, or malformed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{taskId}": {
      "get": {
        "operationId": "getTask",
        "summary": "Get a single task",
        "description": "Returns a task by its ID.",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateTask",
        "summary": "Update a task",
        "description": "Partially updates a task. At least one field must be provided. Setting status to its current value is a no-op (returns 200, no history entry created). The X-User-Id header is required to identify who made the change.",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/XUserId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "status": {
                    "$ref": "#/components/schemas/TaskStatus"
                  },
                  "category": {
                    "oneOf": [
                      { "$ref": "#/components/schemas/TaskCategory" },
                      { "type": "null" }
                    ],
                    "description": "Set or clear the task category. Null clears."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or missing X-User-Id header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteTask",
        "summary": "Delete a task",
        "description": "Permanently deletes a task and all its associated comments and status history entries (cascade).",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Task deleted successfully"
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{taskId}/comments": {
      "post": {
        "operationId": "createComment",
        "summary": "Add a comment to a task",
        "description": "Creates a comment. The X-User-Id header identifies the author.",
        "tags": [
          "comments"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/XUserId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Comment created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comment"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{taskId}/comments/{commentId}": {
      "delete": {
        "operationId": "deleteComment",
        "summary": "Delete a comment",
        "description": "Permanently deletes a comment. Only the comment author (matched via X-User-Id header) may delete it.",
        "tags": [
          "comments"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/XUserId"
          }
        ],
        "responses": {
          "204": {
            "description": "Comment deleted successfully"
          },
          "403": {
            "description": "Forbidden \u2014 caller is not the comment author",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Comment or task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{taskId}/history": {
      "get": {
        "operationId": "getTaskHistory",
        "summary": "Get status transition history for a task",
        "description": "Returns the ordered list of status transitions for a task, sorted by changedAt ascending (oldest first). Returns an empty array if the task exists but has no transitions.",
        "tags": [
          "history"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of status transitions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StatusTransition"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "XUserId": {
        "name": "X-User-Id",
        "in": "header",
        "required": true,
        "description": "Identifies the calling user. Used for ownership checks.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "TaskStatus": {
        "type": "string",
        "enum": [
          "todo",
          "in-progress",
          "done"
        ],
        "description": "Task workflow status"
      },
      "TaskCategory": {
        "type": "string",
        "enum": [
          "work",
          "personal",
          "errands"
        ],
        "description": "Task organizational category",
        "x-data-classification": "internal"
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "x-data-classification": "internal"
          },
          "title": {
            "type": "string",
            "x-data-classification": "internal"
          },
          "description": {
            "type": "string",
            "x-data-classification": "internal"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus",
            "x-data-classification": "internal"
          },
          "category": {
            "oneOf": [
              { "$ref": "#/components/schemas/TaskCategory" },
              { "type": "null" }
            ],
            "description": "Organizational category. Null means uncategorized.",
            "x-data-classification": "internal"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "x-data-classification": "internal"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "x-data-classification": "internal"
          }
        }
      },
      "StatusTransition": {
        "type": "object",
        "required": [
          "id",
          "taskId",
          "oldStatus",
          "newStatus",
          "changedBy",
          "changedAt"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "taskId": {
            "type": "integer"
          },
          "oldStatus": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "newStatus": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "changedBy": {
            "type": "string",
            "description": "Matches X-User-Id of the user who made the change"
          },
          "changedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Comment": {
        "type": "object",
        "required": [
          "id",
          "taskId",
          "text",
          "authorId",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "taskId": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "authorId": {
            "type": "string",
            "description": "Matches X-User-Id of the creator"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BatchDeleteResult": {
        "type": "object",
        "required": [
          "deleted",
          "notFound"
        ],
        "properties": {
          "deleted": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "IDs of tasks that were successfully deleted"
          },
          "notFound": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "IDs that did not match any existing task"
          }
        }
      },
      "BatchUpdateCategoryResult": {
        "type": "object",
        "required": [
          "updated",
          "notFound"
        ],
        "properties": {
          "updated": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "IDs of tasks that were successfully updated"
          },
          "notFound": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "IDs that did not match any existing task"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
