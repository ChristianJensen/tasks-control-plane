# Relay environment — copy to .relay/env and fill in values.
# .relay/env is gitignored; .relay/env.example is committed.

# Slack incoming webhook for PR-ready and task-event notifications (optional)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T.../B.../xxx"

# Discord webhook (optional)
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
